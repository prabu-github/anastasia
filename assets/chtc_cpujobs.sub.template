# submit file
universe = vanilla

# IMPORTANT! Require execute servers that have Staging:
Requirements = (Target.HasCHTCStaging == true)

INIT = INITIAL
USER = USERNAME
PROJ = PROJNAME


container_image = file:///staging/$(INIT)/$(USER)/$(PROJ)/toremote/hytraits-cpu.sif

# Set files to capture log, standard output & error
log = log/$(Cluster)_$(Process).log
error = err/$(Cluster)_$(Process).err
output = out/$(Cluster)_$(Process).out

# transfer pre post

# Specify executable
executable = ./cpujob.sh

# Arguments to pass to the executable
arguments = $(MODEL)

should_transfer_files = YES

max_idle = 1000

request_cpus = 1
request_disk = 48GB
request_memory = 32GB

queue MODEL from PARAMSFILE
